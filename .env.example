# ── Authentication (set BOTH to protect the app with a password) ───────────
APP_USERNAME=admin
APP_PASSWORD=changeme

# ── Database storage ────────────────────────────────────────────────────────
# Point to a persistent volume so your data survives redeploys.
# On Railway: add a volume mounted at /data, then set this.
# Leave blank for local dev (stores properties.db in current directory).
DB_DIR=/data

# ── Scheduled auto-scrape ────────────────────────────────────────────────────
# Hour (0–23, UTC) to run the daily automatic scrape. Default: 2 (2 AM UTC).
SCRAPE_HOUR=2
